# --- App ---
ENV=development
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://homecare:homecare@postgres:5432/homecare

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT (generate strong random secrets for real environments) ---
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_JWT_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Firebase Cloud Messaging ---
FIREBASE_CONFIG=

# --- Object storage (documents, photos, chat attachments) ---
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Maps (distance calculation, geocoding) ---
MAPS_API_KEY=

# --- LLM (Phase 10: AI requirement extraction, Section 22) ---
# An Anthropic API key. Without it, POST /care-requests/extract returns a
# clear 422 (AI_NOT_CONFIGURED) rather than failing unpredictably — every
# other endpoint works normally without this key set.
LLM_API_KEY=
